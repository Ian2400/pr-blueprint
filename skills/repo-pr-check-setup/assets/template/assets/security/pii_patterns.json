{
  "_comment": "Identifier patterns for the PII scan. Shipped as a university's example (puid = a 10-digit student ID with a leading 0); edit the identifiers and the email domain below for your own institution or organization. Python regex, case-insensitive. Column patterns run on normalized header names (camelCase split, lower case, non-alphanumerics -> _), so they use alphanumeric lookarounds instead of \\b. high_columns: an identifier column plus one of these is high at any row count. A bare 'name' column counts as an identifier only next to one of these (alone it is too often a table or file name). quasi_columns: 3+ of these with 10+ rows is medium (re-identifiable without an ID).",
  "identifiers": {
    "puid": "(?<![\\d.\\-])0\\d{9}(?![\\d.\\-])",
    "id_literal": "\\b(?:puid|pu_id|person_uid(?:_r)?|student_id|stu_id|dap_stu_id|pidm|id_number|emplid|donor_id)\\b[^=\\n]{0,20}(?:=|\\bin\\b)\\s*\\(?\\s*'?\\d{5,}",
    "ssn": "(?<!\\d)\\d{3}-\\d{2}-\\d{4}(?!\\d)",
    "ssn_ctx": "\\b(?:ssn|social[_ ]?security(?:[_ ]?(?:no|num|number))?)\\b\\W{0,10}\\d{9}(?!\\d)",
    "card": "(?<![\\d.-])(?:\\d{13,19}|\\d{4}(?:[ -]\\d{4}){3}(?:[ -]\\d{1,3})?|\\d{4}[ -]\\d{6}[ -]\\d{5})(?![\\d.-])",
    "email": "[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+\\.)*example\\.edu",
    "phone": "\\(?\\b[2-9]\\d{2}\\)?[-. ]\\d{3}[-. ]\\d{4}\\b",
    "dob_literal": "\\b(?:dob|birth_?date|birth_?dt|date_of_birth)\\b\\W{0,5}(?:(?:19|20)\\d{2}-\\d{2}-\\d{2}|\\d{1,2}/\\d{1,2}/(?:19|20)\\d{2})",
    "ip": "(?<![\\d.])(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}(?![\\d.])",
    "mac": "(?<![0-9A-F:-])[0-9A-F]{2}(?:[:-][0-9A-F]{2}){5}(?![0-9A-F:-])"
  },
  "ignore_values": "(\\d)\\1{7,}",
  "sensitive_columns": "(?<![A-Za-z0-9])(puid|student_pk|student_key|pu_id|person_uid|student_id|stu_id|pidm|career_account|netid|username|login|email|first[_ ]?name|last[_ ]?name|full[_ ]?name|name|ssn|dob|birth[a-z0-9]*|gpa|grade[a-z0-9]*|address|phone|ethnic[a-z0-9]*|race|gender|sex|visa|citizenship|immigra[a-z0-9]*|covid|test_result|result|salary|aid|pell|efc|income|admit[a-z0-9]*|decision|disab[a-z0-9]*|conduct|counsel[a-z0-9]*|religio[a-z0-9]*|veteran|mac|ip_address|building|location|zip[a-z0-9]*|latitude|longitude)(?![A-Za-z0-9])",
  "identifier_columns": "(?<![A-Za-z0-9])(puid|pu_id|person_uid|student_id|stu_id|pidm|career_account|career_acct|netid|username|login|email|first[_ ]?name|last[_ ]?name|full[_ ]?name|(?:student|stu|person|preferred|legal|given|family|middle|maiden)_?name|surname|f_?name|l_?name|ssn|itin|id_number|donor_id|emplid|student_pk|student_key|stu_pk|person_pk|passport[a-z0-9]*|drivers?_?licen[cs]e[a-z0-9]*|bank_account[a-z0-9]*|account_number|routing_number|iban|card_number)(?![A-Za-z0-9])",
  "high_columns": "(?<![A-Za-z0-9])(ssn|dob|birth_?date|date_of_birth|gpa|cum_gpa|grade[a-z0-9]*|ethnic[a-z0-9]*|race|gender|sex|visa[a-z0-9]*|citizenship|immigra[a-z0-9]*|covid|test_result|vaccin[a-z0-9]*|diagnos[a-z0-9]*|disab[a-z0-9]*|accommodation[a-z0-9]*|aid|pell|efc|income|admit[a-z0-9]*|admission_decision|conduct|counsel[a-z0-9]*|religio[a-z0-9]*|orientation|probation|discipline[a-z0-9]*|passport[a-z0-9]*|drivers?_?licen[cs]e[a-z0-9]*|bank_account[a-z0-9]*|account_number|routing_number|iban|card_number)(?![A-Za-z0-9])",
  "quasi_columns": "(?<![A-Za-z0-9])(zip|zip_?code|postal[a-z0-9]*|county|age|birth_?year|major|cohort|gender|sex|race|ethnic[a-z0-9]*|hometown|high_school[a-z0-9]*|lat|lon|lng|latitude|longitude|ip|ip_address|mac|mac_address|device_id)(?![A-Za-z0-9])"
}
